# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME="fdl4gjvt"
VITE_CLOUDINARY_UPLOAD_PRESET="gallery_upload"

# Firebase Configuration (Defaults to firebase-applet-config.json)
VITE_FIREBASE_PROJECT_ID="tower-control-259d4"
VITE_FIREBASE_API_KEY="AIzaSyDp1YTtf3D77mu2PL2itapeBhz7gtWeIaI"
VITE_FIREBASE_AUTH_DOMAIN="tower-control-259d4.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="tower-control-259d4.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="76181864938"
VITE_FIREBASE_APP_ID="1:76181864938:web:cc574e86069ded63e43293"
VITE_FIREBASE_DATABASE_ID="(default)"

