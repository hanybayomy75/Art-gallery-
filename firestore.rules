rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSiteOwner() {
      return isAuthenticated() && (
        ('email' in request.auth.token && request.auth.token.email.lower() == 'hany.bayomy75@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner')
      );
    }

    // Helper to check if user is admin or owner from user collection
    function isAdminOrOwner() {
      return isAuthenticated() && (
        isSiteOwner() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'])
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || isSiteOwner()
      );
      allow delete: if isSiteOwner();
    }

    // Artworks collection
    match /artworks/{artId} {
      // Anyone can read approved artworks; owners/admins or the creator can read pending/rejected
      allow read: if resource.data.status == 'approved' || 
                  !('status' in resource.data) ||
                  (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdminOrOwner()));
      
      // Authenticated users can create artworks with initial status "pending" (unless admin/owner)
      allow create: if isAuthenticated() && 
                     request.resource.data.userId == request.auth.uid &&
                     (request.resource.data.status == 'pending' || isAdminOrOwner());
      
      // Update rule: author can edit their own works (without changing status to approved unless admin); admin/owner can edit any work
      allow update: if isAuthenticated() && (
        isAdminOrOwner() ||
        (resource.data.userId == request.auth.uid && (request.resource.data.status == resource.data.status || request.resource.data.status == 'pending')) ||
        // Allow aggregate counters updates by authenticated users
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'viewsCount', 'ratingAverage', 'ratingCount', 'ratingSum', 'ratingDistribution', 'favoritesCount']))
      );
      
      // Delete rule: author can delete their own work; admin/owner can delete any work
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdminOrOwner()
      );

      // Likes subcollection
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isAuthenticated() && request.auth.uid == userId;
      }

      // Ratings subcollection
      match /ratings/{userId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
      }

      // Favorites subcollection
      match /favorites/{userId} {
        allow read: if true;
        allow create, delete: if isAuthenticated() && request.auth.uid == userId;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || isAdminOrOwner()
        );
      }
    }

    // Notifications collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.recipientUserId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.actorUserId == request.auth.uid || isAdminOrOwner());
      allow update: if isAuthenticated() && (resource.data.recipientUserId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.recipientUserId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Site settings & categories
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdminOrOwner();
    }

    // Dynamic Categories collection
    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrOwner();
    }

    // Contact messages collection
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrOwner() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
  }
}
